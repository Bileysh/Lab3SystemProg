<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS0162;CS0414</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YaccLexTools" Version="1.2.3" />
  </ItemGroup>

  <ItemGroup>
    <YaccFile Include="Grammars\ExprPrec.y"          OutputFile="Grammars\ExprPrec.g.cs"          Arguments="/nolines /conflicts /report /verbose" />
    <YaccFile Include="Grammars\ExprNoPrec.y"        OutputFile="Grammars\ExprNoPrec.g.cs"        Arguments="/nolines /conflicts /report /verbose" />
    <YaccFile Include="Grammars\Layered.y"           OutputFile="Grammars\Layered.g.cs"           Arguments="/nolines /conflicts /report /verbose" />
    <YaccFile Include="Grammars\DanglingElse.y"      OutputFile="Grammars\DanglingElse.g.cs"      Arguments="/nolines /conflicts /report /verbose" />
    <YaccFile Include="Grammars\LalrReduceReduce.y"  OutputFile="Grammars\LalrReduceReduce.g.cs"  Arguments="/nolines /conflicts /report /verbose" />
    <YaccFile Include="Grammars\VoidReduceReduce.y"  OutputFile="Grammars\VoidReduceReduce.g.cs"  Arguments="/nolines /conflicts /report /verbose" />
    <None Include="Grammars\*.y;Grammars\*.report.html" CopyToOutputDirectory="PreserveNewest" />
    <None Include="*.conflicts" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
